# Build output (ESP-IDF creates this in firmware/)
firmware/build/
sdkconfig
sdkconfig.old
firmware/sdkconfig.defaults

# IDE/Editor
.vscode/
.idea/
*.swp
*.swo
*~

# macOS
.DS_Store

# ESP-IDF managed components (auto-downloaded)
managed_components/

# Dependency lock (regenerated on build)
dependencies.lock

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Temporary files
*.tmp
*.log

# Test build artifacts
test/*.o
test/test_runner
test/src/*.o

# Secrets (contains passwords and credentials)
config/secrets.yaml
