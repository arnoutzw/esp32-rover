# =============================================================================
# ESP32 Rover Secrets Configuration - EXAMPLE
# =============================================================================
# Copy this file to secrets.yaml and fill in your actual credentials.
# The secrets.yaml file is ignored by git to protect your credentials.
# =============================================================================

# WiFi Access Point password (for rover's own AP)
wifi_ap_password: "your-ap-password"

# WiFi Station credentials (your home/office network)
wifi_sta_ssid: "your-wifi-ssid"
wifi_sta_password: "your-wifi-password"

# MQTT broker credentials (leave empty for anonymous)
mqtt_username: ""
mqtt_password: ""

# OTA update password
ota_password: "your-ota-password"
